{
  const database = db.getSiblingDB("maintenance_service_orders");

  print("\n1. Equipamentos com seus setores");

  database.equipamento.aggregate([
    {
      $lookup: {
        from: "setor",
        localField: "sectorId",
        foreignField: "_id",
        as: "sector"
      }
    },
    {
      $unwind: "$sector"
    },
    {
      $project: {
        _id: 0,
        equipment: "$name",
        serialNumber: 1,
        sector: "$sector.name"
      }
    }
  ]).toArray();

  print("\n2. Ordens de serviço com equipamentos");

  database.ordem_servico.aggregate([
    {
      $lookup: {
        from: "equipamento",
        localField: "equipmentId",
        foreignField: "_id",
        as: "equipment"
      }
    },
    {
      $unwind: "$equipment"
    },
    {
      $project: {
        _id: 0,
        code: 1,
        status: 1,
        equipment: "$equipment.name",
        serialNumber: "$equipment.serialNumber"
      }
    }
  ]).toArray();

  print("\n3. Ordens com seus técnicos");

  database.ordem_servico.aggregate([
    {
      $lookup: {
        from: "tecnico",
        localField: "technicianId",
        foreignField: "_id",
        as: "technician"
      }
    },
    {
      $unwind: "$technician"
    },
    {
      $project: {
        _id: 0,
        code: 1,
        status: 1,
        technician: "$technician.name",
        specialty: "$technician.specialty"
      }
    }
  ]).toArray();

  print("\n4. Peças utilizadas nas ordens");

  database.ordem_servico.aggregate([
    {
      $unwind: "$parts"
    },
    {
      $lookup: {
        from: "peca",
        localField: "parts.partId",
        foreignField: "_id",
        as: "part"
      }
    },
    {
      $unwind: "$part"
    },
    {
      $project: {
        _id: 0,
        serviceOrder: "$code",
        part: "$part.name",
        quantity: "$parts.quantity",
        unitPrice: "$part.unitPrice"
      }
    }
  ]).toArray();
}
